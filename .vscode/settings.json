{
  "typescript.preferences.include.packageJsonAutoImports": "off",
  "files.associations": {
    "*.test.ts": "typescript"
  },
  "typescript.validate.enable": true,
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "[typescript]": {
    "typescript.preferences.includePackageJsonAutoImports": "off"
  },
  "typescript.surveys.enabled": false,
  "typescript.suggest.includeAutomaticOptionalChainCompletions": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/dist": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  }
}